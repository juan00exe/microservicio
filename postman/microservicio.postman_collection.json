{
  "info": {
    "name": "Microservicio de productos",
    "description": "Pruebas de la API de productos. Ejecuta la colección completa en orden con Run collection: cada petición guarda las variables que necesita la siguiente (tokens, productId). El admin se toma de las variables adminEmail/adminPassword (por defecto, las de docker-compose).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "admin12345"
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": "secreto123"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "suffix",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
          "pm.test('Incluye X-Request-ID', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string').and.not.empty);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado del servicio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email único por ejecución para poder repetir la colección.",
                  "pm.collectionVariables.set('userEmail', 'user_' + Date.now().toString(36) + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('Se crea con rol user', () => {",
                  "    pm.expect(u.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    pm.expect(u.role).to.eql('user');",
                  "});",
                  "pm.test('No devuelve la contraseña', () => pm.expect(u).to.not.have.any.keys('password', 'password_hash'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Registrar email repetido (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.eql('email already registered'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"otraclave123\"\n}"
            }
          }
        },
        {
          "name": "Login usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test('Devuelve un token Bearer', () => {",
                  "    pm.expect(t.token_type).to.eql('Bearer');",
                  "    pm.expect(t.access_token.split('.')).to.have.lengthOf(3);",
                  "    pm.expect(t.expires_in).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('userToken', t.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Perfil del usuario (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el usuario del token', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('userEmail')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().error).to.eql('invalid email or password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"incorrecta\"\n}"
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 (revisa adminEmail/adminPassword si falla)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Permisos",
      "item": [
        {
          "name": "Listar productos sin token (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear producto sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Header WWW-Authenticate', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No debería crearse\",\n  \"price\": 1\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear producto con token de user (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));",
                  "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.eql('requires role admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No debería crearse\",\n  \"price\": 1\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Token inválido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token.falso.123",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CRUD de productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufijo único para que el filtro por nombre solo encuentre los productos de esta ejecución.",
                  "pm.collectionVariables.set('suffix', Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('Devuelve el producto con id', () => {",
                  "    pm.expect(p.id).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(p.name).to.eql('Teclado ' + pm.collectionVariables.get('suffix'));",
                  "    pm.expect(p.price).to.eql(49.9);",
                  "    pm.expect(p.stock).to.eql(10);",
                  "});",
                  "pm.test('Header Location apunta al producto', () => pm.expect(pm.response.headers.get('Location')).to.eql('/products/' + p.id));",
                  "pm.collectionVariables.set('productId', p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado {{suffix}}\",\n  \"description\": \"Teclado mecánico\",\n  \"price\": 49.9,\n  \"stock\": 10\n}"
            }
          }
        },
        {
          "name": "Obtener producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el producto creado', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('productId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Listar productos (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Formato de página', () => {",
                  "    pm.expect(body).to.have.keys('items', 'page', 'limit', 'total', 'total_pages');",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.limit).to.eql(5);",
                  "    pm.expect(body.items.length).to.be.at.most(5);",
                  "    pm.expect(body.total_pages).to.eql(Math.ceil(body.total / 5));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Encuentra solo el producto creado (sin distinguir mayúsculas)', () => {",
                  "    pm.expect(body.total).to.eql(1);",
                  "    pm.expect(body.items[0].id).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?name=TECLADO {{suffix}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "TECLADO {{suffix}}"
                }
              ]
            }
          }
        },
        {
          "name": "Actualizar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('Campos actualizados', () => {",
                  "    pm.expect(p.price).to.eql(39.9);",
                  "    pm.expect(p.stock).to.eql(8);",
                  "    pm.expect(new Date(p.updated_at) > new Date(p.created_at)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado {{suffix}}\",\n  \"description\": \"Teclado mecánico (oferta)\",\n  \"price\": 39.9,\n  \"stock\": 8\n}"
            }
          }
        },
        {
          "name": "Borrar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Obtener producto borrado (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.eql('product not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "description": "Usa el token de admin guardado por 'Login admin'."
    },
    {
      "name": "Errores y validaciones",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Incluye mensaje de error', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Crear sin nombre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": 10\n}"
            }
          }
        },
        {
          "name": "Precio negativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mouse\",\n  \"price\": -5\n}"
            }
          }
        },
        {
          "name": "Campo desconocido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mouse\",\n  \"color\": \"rojo\"\n}"
            }
          }
        },
        {
          "name": "JSON mal formado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": "
            }
          }
        },
        {
          "name": "Limit fuera de rango",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Page inválida",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "abc"
                }
              ]
            }
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      }
    }
  ]
}
